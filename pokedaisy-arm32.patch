index 0000000..4736511
--- /dev/null
+++ b/.github/workflows/arm32.yml
@@ -0,0 +1,60 @@
+# Builds the armeabi-v7a (32-bit ARM) APK of this fork: run it from the Actions tab (Run workflow)
+# or by pushing to the `arm32` branch. The APK comes out as a downloadable artifact of the run.
+# Signed with a key made fresh for each run (sideloading only): uninstall the previous build first,
+# since Android refuses to update an app over an APK signed with a different key.
+name: Build arm32 APK
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [arm32]
+
+permissions:
+  contents: read
+
+jobs:
+  apk:
+    name: armeabi-v7a release APK
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
+        with:
+          submodules: recursive
+
+      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4.9.1
+        with:
+          distribution: temurin
+          java-version: 17
+
+      - uses: android-actions/setup-android@9fc6c4e9069bf8d3d10b2204b1fb8f6ef7065407 # v3.2.2
+        with:
+          packages: platform-tools
+          log-accepted-android-sdk-licenses: false
+
+      - name: NDK + CMake (app/build.gradle.kts pins them)
+        run: sdkmanager --install "ndk;28.2.13676358" "cmake;3.22.1" "platforms;android-34"
+
+      - uses: gradle/actions/setup-gradle@748248ddd2a24f49513d8f472f81c3a07d4d50e1 # v4.4.4
+
+      - name: Signing key for this run (app/build.gradle.kts reads keystore.properties)
+        run: |
+          keytool -genkeypair -keystore "$RUNNER_TEMP/fork.jks" -storepass forkpass123 -keypass forkpass123 \
+            -alias fork -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=PokeDaisy arm32 fork"
+          printf 'storeFile=%s\nstorePassword=forkpass123\nkeyAlias=fork\nkeyPassword=forkpass123\n' \
+            "$RUNNER_TEMP/fork.jks" > keystore.properties
+
+      - name: Release APK
+        run: ./gradlew :app:assembleRelease --stacktrace
+
+      - name: Show what the APK carries (expect lib/armeabi-v7a only)
+        run: |
+          apk="$(ls app/build/outputs/apk/release/*.apk | head -1)"
+          echo "$apk"
+          unzip -l "$apk" | grep -E 'lib/' || true
+
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: PokeDaisy-arm32-apk
+          path: app/build/outputs/apk/release/*.apk
+          retention-days: 30
